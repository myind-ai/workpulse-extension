# Build-time switches. Copy to .env (gitignored) and rebuild. Everything is on unless set to false.
# WXT_FEATURE_TICK=false          # Tick, the cat, on cards, empty pages and busy strips
# WXT_FEATURE_BRAIN=false         # the Brain page
# WXT_FEATURE_BRIDGE_SYNC=false   # reading/writing bridge/ in the backup repository
# WXT_FEATURE_PERSONAL=false      # personal side projects in the Brain

# The official Zoho API path stays off unless asked for.
# WXT_ENABLE_API=true
